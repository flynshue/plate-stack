{{define "form"}}
<form action="/" method="post">
<div class="field">
    <label class="label">Barbell Weight in lbs</label>
    <div class="control">
      <input class="input" type="number" value="45" name="barbell">
    </div>
  </div>

  <div class="field">
    <label class="label">Target Lift Weight in lbs</label>
    <div class="control">
      <input class="input" type="number" value="0" name="target">
    </div>
  </div>

  {{range $i, $p := .Plates}}
  <input type="hidden" name="plate.{{$i}}.weight" value="{{$p.Weight}}" />
  <div class="field">
    <label class="label">{{$p.Weight}} lbs Plates (pairs)</label>
    <div class="control">
      <input class="input" type="number" min="0" name="plate.{{$i}}.quantity" value="{{$p.Quantity}}">
    </div>
  </div>
  {{end}}
  <div class="control">
    <button class="button is-primary">Submit</button>
  </div>
</form>
{{end}}

{{define "plateSet"}}
<p class="subtitle">Current Plate Set</p>
<table class="table">
  <tr>
    {{range .PlateSet}}
    <th>{{.}} lbs</th>
    {{end}}
  </tr>
</table>
{{end}}

{{define "results"}}
<div class="content">
<h3>Weight Plate Combinations <strong>One Side</strong></h3>
<hr />
<h4>Target Lift Weight in lbs: {{.TargetWeight}}</h4>
{{range $index, $combo := .Combinations}}
<ul>
  <li>
    {{range $combo}}
    {{printf "%.1flbs  " .}}
    {{end}}
  </li>
</ul>
{{end}}
</div>
{{end}}