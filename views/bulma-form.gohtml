{{define "form"}}
<form action="/" method="post">
  <div class="field">
    <label class="label">Barbell Weight (lbs)</label>
    <div class="control">
      <input class="input" type="number" value="45" name="barbell" step="any">
    </div>
  </div>

  <div class="field">
    <label class="label">Target Lift Weight (lbs)</label>
    <div class="control">
      <input class="input" type="number" value="0" name="target" step="2.5" min="0">
    </div>
  </div>

  <label class="label">Available Plates (pairs)</label>
  <div class="plate-grid">
  {{range $i, $p := .Plates}}
  <input type="hidden" name="plate.{{$i}}.weight" value="{{$p.Weight}}" />
  <div class="field">
    <label class="label">{{$p.Weight}} lbs</label>
    <div class="control">
      <input class="input" type="number" min="0" name="plate.{{$i}}.quantity" value="{{$p.Quantity}}">
    </div>
  </div>
  {{end}}
  </div>

  <div class="control mt-4">
    <button class="button is-primary is-fullwidth">Calculate</button>
  </div>
</form>
{{end}}

{{define "plateSet"}}
<p class="subtitle">Current Plate Set</p>
<table class="table">
  <tr>
    {{range .PlateSet}}
    <th>{{.}} lbs</th>
    {{end}}
  </tr>
</table>
{{end}}

{{define "results"}}
<div class="content">
  <h3 class="title is-4">Weight Plates Needed <span class="tag is-light is-medium">One side of the bar</span></h3>
  <p class="subtitle is-6">Target: <strong>{{.TargetWeight}} lbs</strong></p>
  <hr />
  {{if .Combinations}}
    {{range $index, $combo := .Combinations}}
    <div class="box combo-row">
      <p class="heading has-text-grey mb-2">Option {{add1 $index}}</p>
      <div class="tags">
        {{range $combo}}
        <span class="tag is-primary is-medium">{{printf "%.4g" .}} lbs</span>
        {{end}}
      </div>
    </div>
    {{end}}
  {{else}}
    <p class="has-text-grey">No combinations found for this target weight.</p>
  {{end}}
</div>
{{end}}
